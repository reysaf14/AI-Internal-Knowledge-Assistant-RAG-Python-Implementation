# Environment template (canonical per .ai/knowledge/environment-schema.md)
# Salin ke .env untuk profile lokal; JANGAN commit .env / .env.test / .runtime/.
# Nilai credential nyata diisi Human melalui jalur runtime yang disetujui.

# --- Profile ---
# local | test | vps
APP_ENV=local

# --- Corpus & index ---
# DOCS_PATH diperlukan untuk ingest; bot memakai index aktif yang sudah ada.
DOCS_PATH=docs
# Lokasi SQLite index + runtime state (parent dibuat aman, di-git-ignore).
INDEX_PATH=.runtime/index.sqlite3

# --- Telegram (diperlukan untuk bot live; kosong untuk ingest/test) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLL_TIMEOUT_SECONDS=30
# Timeout request Telegram non-polling; dikalibrasi terhadap REQ-006.
TELEGRAM_REQUEST_TIMEOUT_SECONDS=4

# --- LLM generik (endpoint OpenAI-compatible; schema canonical v1.1) ---
# Adapter menempelkan "/chat/completions" ke nilai ini.
LLM_BASE_URL=http://127.0.0.1:8080/v1
# Kosong = tanpa header Authorization (model lokal tanpa auth).
LLM_API_KEY=
LLM_MODEL=local-default
# Timeout pembangkitan jawaban; sisakan headroom dari budget <5,0 detik.
LLM_TIMEOUT_SECONDS=3

# --- Batas input & observability ---
MAX_QUESTION_CHARS=2000
LOG_LEVEL=info

# Catatan: nama lama MODEL_BASE_URL / MODEL_NAME / MODEL_TIMEOUT_SECONDS masih
# diterima sebagai fallback kompatibilitas; LLM_* selalu diprioritaskan.
