# Canonical runtime template: .ai/knowledge/environment-schema.md
# Copy to .env for Docker Compose. Never commit .env or runtime data.
# Human provisions real credentials through the approved runtime path.

# --- Docker image and profile ---
APP_ENV=container
RAG_IMAGE=rag-assistant:local

# --- Corpus and persistent index volume ---
DOCS_PATH=docs
INDEX_PATH=.runtime/index.sqlite3

# --- Telegram (required for bot only; empty for ingest) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLL_TIMEOUT_SECONDS=30
TELEGRAM_REQUEST_TIMEOUT_SECONDS=4

# Sandbox-only credential for the host-side Telegram E2E harness.
# Compose intentionally does not pass this variable into the bot container.
TELEGRAM_ECHO_BOT_TOKEN=

# --- OpenAI-compatible model endpoint reachable from the container ---
# Docker Desktop host alias; change the port/path to the approved local service.
LLM_BASE_URL=http://host.docker.internal:8080/v1
LLM_API_KEY=
LLM_MODEL=local-default
LLM_TIMEOUT_SECONDS=30

# --- Retrieval (ADR-002) ---
RAG_CONTEXT_LIMIT=5

# --- Input and observability ---
MAX_QUESTION_CHARS=2000
LOG_LEVEL=info
